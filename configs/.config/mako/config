# ───────────────────────────
#  Mako Notification Daemon
#  Theme: Catppuccin Mocha
# ───────────────────────────

# Timing
default-timeout=10000
max-visible=5
sort=-time

# Click notification -> focus/launch source app (niri IPC)
on-button-left=exec python3 "$HOME/.config/mako/focus-or-launch.py" "$id"

# Style (Catppuccin Mocha colors with ~80% opacity)
border-radius=12
width=400
margin=10,10
padding=15,20

# Colors with alpha transparency (CC = ~80% opacity)
background-color=#1e1e2eCC
text-color=#cdd6f4
border-color=#cba6f7
progress-color=over #89b4fa

# Critical notifications
[urgency=critical]
background-color=#f38ba8CC
text-color=#1e1e2e
border-color=#f38ba8

# Low urgency
[urgency=low]
background-color=#313244CC
